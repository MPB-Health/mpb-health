# Copy to .env (or merge with your existing file) and fill from Supabase: Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Membership / sales analytics (Unified Analytics → Membership & Sales tab) is
# read through the membership-analytics-proxy edge function, which derives its
# URL from VITE_SUPABASE_URL above. The browser is never given a key for the
# mobile app project, so there is nothing to set here.
#
# The proxy needs these secrets on the primary Supabase project (the same pair
# analytics-hub-proxy already uses):
#   MOBILE_APP_SUPABASE_URL
#   MOBILE_APP_SERVICE_ROLE_KEY

# Rich text for ticket replies (Tiptap). Requires ITSTS migration (content_format) + ticket-proxy deploy.
# Use "true" to enable; omit or "false" for legacy textarea + plain text.
VITE_RICH_TICKET_EDITOR=true
