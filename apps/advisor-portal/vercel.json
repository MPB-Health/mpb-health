{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "cd ../.. && pnpm turbo build --filter=@mpbhealth/advisor-portal",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "saudemax.aryxcloud.com" }],
      "destination": "https://aos.aryxcloud.com/saudemax",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [{ "type": "host", "value": "saudemax.aryxcloud.com" }],
      "destination": "https://aos.aryxcloud.com/saudemax/:path*",
      "permanent": true
    },
    { "source": "/advisor-agreement", "destination": "/login", "permanent": true },
    { "source": "/advisor-agreement/", "destination": "/login", "permanent": true },
    { "source": "/advisor-playbook", "destination": "/login", "permanent": true },
    { "source": "/advisor-playbook/", "destination": "/login", "permanent": true },
    { "source": "/contact", "destination": "/login", "permanent": true },
    { "source": "/contact/", "destination": "/login", "permanent": true },
    { "source": "/eo", "destination": "/login", "permanent": true },
    { "source": "/eo/", "destination": "/login", "permanent": true },
    { "source": "/event-participation-request", "destination": "/login", "permanent": true },
    { "source": "/event-participation-request/", "destination": "/login", "permanent": true },
    { "source": "/interview-questions", "destination": "/login", "permanent": true },
    { "source": "/interview-questions/", "destination": "/login", "permanent": true },
    { "source": "/margaritaville-contest", "destination": "/login", "permanent": true },
    { "source": "/margaritaville-contest/", "destination": "/login", "permanent": true },
    { "source": "/sederacontest", "destination": "/login", "permanent": true },
    { "source": "/sederacontest/", "destination": "/login", "permanent": true },
    { "source": "/advisor-bulletin-:slug*", "destination": "/login", "permanent": true },
    { "source": "/august-26-2025-bulletin", "destination": "/login", "permanent": true },
    { "source": "/august-26-2025-bulletin/", "destination": "/login", "permanent": true },
    { "source": "/important-update-regarding-price-increase-2026", "destination": "/login", "permanent": true },
    { "source": "/important-update-regarding-price-increase-2026/", "destination": "/login", "permanent": true },
    { "source": "/note-to-advisors-2026-rates-e123-update-in-progress", "destination": "/login", "permanent": true },
    { "source": "/note-to-advisors-2026-rates-e123-update-in-progress/", "destination": "/login", "permanent": true },
    { "source": "/january-28th-2025", "destination": "/login", "permanent": true },
    { "source": "/january-28th-2025/", "destination": "/login", "permanent": true },
    { "source": "/courses/:path*", "destination": "/login", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/((?!api|assets|favicon|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-HSOW0F1TINNHjS314VcMKCN+TYNeBBFCrEwYsaNim/g=' https://vercel.live https://meet.jit.si https://assets.calendly.com https://www.cognitoforms.com https://static.cognitoforms.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://www.cognitoforms.com https://static.cognitoforms.com https://assets.calendly.com https://vercel.live; font-src 'self' https://fonts.gstatic.com https://www.cognitoforms.com https://static.cognitoforms.com https://r2cdn.perplexity.ai; img-src 'self' data: https: blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://www.cognitoforms.com https://static.cognitoforms.com https://calendly.com https://meet.jit.si https://vercel.live https://*.vercel.live; frame-src 'self' https://www.youtube.com https://*.supabase.co https://advisor.mpb.health https://view.officeapps.live.com https://docs.google.com https://www.cognitoforms.com https://calendly.com https://vercel.live https://player.vimeo.com https://assets.ctfassets.net; object-src 'self' https://*.supabase.co; frame-ancestors 'self'; form-action 'self' https://www.cognitoforms.com; base-uri 'self'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self)"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
