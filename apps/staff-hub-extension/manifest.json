{
  "manifest_version": 3,
  "name": "MPB Staff Hub",
  "short_name": "Staff Hub",
  "description": "Quick access to MPB Health Staff Hub for clock-in, portals, and time off.",
  "version": "1.0.0",
  "action": {
    "default_title": "Open Staff Hub",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["sidePanel", "tabs"]
}
