{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "cd ../.. && pnpm turbo build --filter=@mpbhealth/website",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.mpb.health" }],
      "destination": "https://mpb.health/:path*",
      "permanent": true
    },
    { "source": "/join-team", "destination": "/join-our-team", "permanent": true },
    { "source": "/join-team/", "destination": "/join-our-team", "permanent": true },
    { "source": "/download-mpbhealth-app", "destination": "/download-app", "permanent": true },
    { "source": "/download-mpbhealth-app/", "destination": "/download-app", "permanent": true },
    { "source": "/individuals", "destination": "/individuals-and-families", "permanent": true },
    { "source": "/individuals/", "destination": "/individuals-and-families", "permanent": true },
    { "source": "/freequote", "destination": "/get-started", "permanent": true },
    { "source": "/freequote/", "destination": "/get-started", "permanent": true },
    { "source": "/calculator", "destination": "/get-started", "permanent": true },
    { "source": "/calculator/", "destination": "/get-started", "permanent": true },
    { "source": "/quote", "destination": "/get-a-quote", "permanent": true },
    { "source": "/quote/", "destination": "/get-a-quote", "permanent": true },
    { "source": "/forms/membership-changes", "destination": "/membership-changes", "permanent": true },
    { "source": "/forms/membership-changes/", "destination": "/membership-changes", "permanent": true },
    { "source": "/forms/welcome-call-survey", "destination": "/welcome-call-survey", "permanent": true },
    { "source": "/forms/welcome-call-survey/", "destination": "/welcome-call-survey", "permanent": true },
    { "source": "/resource-library", "destination": "/resources", "permanent": true },
    { "source": "/resource-library/", "destination": "/resources", "permanent": true },
    { "source": "/individuals-families", "destination": "/individuals-and-families", "permanent": true },
    { "source": "/individuals-families/", "destination": "/individuals-and-families", "permanent": true },
    { "source": "/businesses-organizations", "destination": "/businesses-and-organizations", "permanent": true },
    { "source": "/businesses-organizations/", "destination": "/businesses-and-organizations", "permanent": true },
    { "source": "/review-or-change-advisor", "destination": "/healthcare-advisor-review-change", "permanent": true },
    { "source": "/review-or-change-advisor/", "destination": "/healthcare-advisor-review-change", "permanent": true },
    { "source": "/gd-archive", "destination": "/blog", "permanent": true },
    { "source": "/gd-archive/", "destination": "/blog", "permanent": true },
    { "source": "/gd-archive-item", "destination": "/blog", "permanent": true },
    { "source": "/gd-archive-item/", "destination": "/blog", "permanent": true },
    { "source": "/3d-flip-book/direct", "destination": "/3d-flip-book/direct-handbook", "permanent": true },
    { "source": "/3d-flip-book/direct/", "destination": "/3d-flip-book/direct-handbook", "permanent": true },
    { "source": "/places/:path*", "destination": "/", "permanent": true },
    {
      "source": "/:year(20\\d{2})/:month(\\d{2})/:day(\\d{2})/:slug*",
      "destination": "/blog/:slug*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api|assets|favicon|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Content-Type",
          "value": "image/webp"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap(.*)\\.xml",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://vercel.live https://*.vercel.live https://www.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net https://snap.licdn.com https://static.ads-twitter.com https://s.pinimg.com https://ct.pinterest.com https://analytics.tiktok.com https://www.redditstatic.com https://sc-static.net https://www.clarity.ms https://static.hotjar.com https://salesiq.zohopublic.com https://salesiq.zoho.com https://salesiq.zohopublic.eu https://js.zohocdn.com https://static.zohocdn.com https://chimpstatic.com https://*.mailchimp.com https://assets.calendly.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://css.zohocdn.com https://static.zohocdn.com https://assets.calendly.com https://vercel.live; font-src 'self' data: https://fonts.gstatic.com https://css.zohocdn.com https://static.zohocdn.com https://assets.calendly.com; img-src 'self' data: https: blob:; connect-src 'self' https://challenges.cloudflare.com https://*.supabase.co wss://*.supabase.co https://www.google-analytics.com https://analytics.google.com https://www.facebook.com https://px.ads.linkedin.com https://analytics.twitter.com https://ct.pinterest.com https://pixel-config.reddit.com https://analytics.tiktok.com https://www.reddit.com https://tr.snapchat.com https://www.clarity.ms https://*.hotjar.com https://*.hotjar.io wss://*.hotjar.com https://salesiq.zohopublic.com https://salesiq.zoho.com https://salesiq.zohopublic.eu wss://salesiq.zohopublic.com wss://salesiq.zoho.com wss://vts.zohopublic.com https://ipapi.co https://ipwho.is https://ip-api.com https://api.bigdatacloud.net https://api.zippopotam.us https://*.list-manage.com https://*.mailchimp.com https://calendly.com https://vercel.live https://*.vercel.live wss://vercel.live wss://*.vercel.live; frame-src 'self' https://challenges.cloudflare.com https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://www.cognitoforms.com https://salesiq.zohopublic.com https://salesiq.zoho.com https://salesiq.zohopublic.eu https://vars.hotjar.com https://www.google.com https://calendly.com https://drive.google.com https://docs.google.com https://vercel.live https://ct.pinterest.com; child-src 'self' https://www.cognitoforms.com https://salesiq.zohopublic.com https://salesiq.zoho.com https://salesiq.zohopublic.eu https://calendly.com; media-src 'self' https: data:; frame-ancestors 'self'; form-action 'self'; base-uri 'self'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "0"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self)"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/docs/:path*.pdf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
