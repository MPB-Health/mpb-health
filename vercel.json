{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install && node apps/website/scripts/generate-cms-redirects.mjs && node apps/website/scripts/generate-known-routes.mjs",
  "buildCommand": "pnpm turbo build --filter=@mpbhealth/website",
  "outputDirectory": "apps/website/dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.mpb.health" }],
      "destination": "https://mpb.health/:path*",
      "permanent": true
    },
    { "source": "/join-team", "destination": "/join-our-team", "permanent": true },
    { "source": "/join-team/", "destination": "/join-our-team", "permanent": true },
    { "source": "/download-mpbhealth-app", "destination": "/download-app", "permanent": true },
    { "source": "/download-mpbhealth-app/", "destination": "/download-app", "permanent": true },
    { "source": "/individuals", "destination": "/individuals-and-families", "permanent": true },
    { "source": "/individuals/", "destination": "/individuals-and-families", "permanent": true },
    { "source": "/freequote", "destination": "/get-started", "permanent": true },
    { "source": "/freequote/", "destination": "/get-started", "permanent": true },
    { "source": "/calculator", "destination": "/get-started", "permanent": true },
    { "source": "/calculator/", "destination": "/get-started", "permanent": true },
    { "source": "/quote", "destination": "/get-a-quote", "permanent": true },
    { "source": "/quote/", "destination": "/get-a-quote", "permanent": true },
    { "source": "/forms/membership-changes", "destination": "/membership-changes", "permanent": true },
    { "source": "/forms/membership-changes/", "destination": "/membership-changes", "permanent": true },
    { "source": "/forms/member-change-request", "destination": "/membership-changes", "permanent": true },
    { "source": "/forms/member-change-request/", "destination": "/membership-changes", "permanent": true },
    { "source": "/forms/welcome-call-survey", "destination": "/welcome-call-survey", "permanent": true },
    { "source": "/forms/welcome-call-survey/", "destination": "/welcome-call-survey", "permanent": true },
    { "source": "/resource-library", "destination": "/resources", "permanent": true },
    { "source": "/resource-library/", "destination": "/resources", "permanent": true },
    { "source": "/individuals-families", "destination": "/individuals-and-families", "permanent": true },
    { "source": "/individuals-families/", "destination": "/individuals-and-families", "permanent": true },
    { "source": "/businesses-organizations", "destination": "/businesses-and-organizations", "permanent": true },
    { "source": "/businesses-organizations/", "destination": "/businesses-and-organizations", "permanent": true },
    { "source": "/review-or-change-advisor", "destination": "/healthcare-advisor-review-change", "permanent": true },
    { "source": "/review-or-change-advisor/", "destination": "/healthcare-advisor-review-change", "permanent": true },
    { "source": "/gd-archive", "destination": "/blog", "permanent": true },
    { "source": "/gd-archive/", "destination": "/blog", "permanent": true },
    { "source": "/gd-archive-item", "destination": "/blog", "permanent": true },
    { "source": "/gd-archive-item/", "destination": "/blog", "permanent": true },
    { "source": "/3d-flip-book/direct", "destination": "/3d-flip-book/direct-handbook", "permanent": true },
    { "source": "/3d-flip-book/direct/", "destination": "/3d-flip-book/direct-handbook", "permanent": true },
    { "source": "/3d-flip-book/ebooktravis", "destination": "/3d-flip-book/direct-handbook", "permanent": true },
    { "source": "/places/:path*", "destination": "/", "permanent": true },
    { "source": "/benefits/preventive-care", "destination": "/features/preventive-care", "permanent": true },
    { "source": "/benefits/telehealth", "destination": "/features/primary-care", "permanent": true },
    { "source": "/benefits/maternity", "destination": "/features/maternity-care", "permanent": true },
    { "source": "/healthshare-faq", "destination": "/faq", "permanent": true },
    { "source": "/healthshare-faq/", "destination": "/faq", "permanent": true },
    { "source": "/all-about-heatlh-share-programs", "destination": "/how-it-works", "permanent": true },
    { "source": "/medical-cost-sharing", "destination": "/how-it-works", "permanent": true },
    { "source": "/medical-cost-sharing/", "destination": "/how-it-works", "permanent": true },
    { "source": "/affordable-health-insurance-alternatives", "destination": "/individuals-and-families", "permanent": true },
    { "source": "/mental-health-coverage-health-plans", "destination": "/features/mental-health", "permanent": true },
    {
      "source": "/the-best-alternative-to-health-insurance-medical-cost-sharing",
      "destination": "/how-it-works",
      "permanent": true
    },
    {
      "source": "/the-best-alternative-to-health-insurance-medical-cost-sharing/",
      "destination": "/how-it-works",
      "permanent": true
    },
    {
      "source": "/health-sharing-community-groups-how-they-create-affordable-healthcare-alternatives",
      "destination": "/how-it-works",
      "permanent": true
    },
    {
      "source": "/health-sharing-community-groups-how-they-create-affordable-healthcare-alternatives/",
      "destination": "/how-it-works",
      "permanent": true
    },
    {
      "source": "/exploring-affordable-and-flexible-health-insurance-alternatives-for-small-businesses",
      "destination": "/businesses-and-organizations",
      "permanent": true
    },
    {
      "source": "/exploring-affordable-and-flexible-health-insurance-alternatives-for-small-businesses/",
      "destination": "/businesses-and-organizations",
      "permanent": true
    },
    {
      "source": "/the-importance-and-benefits-of-group-health-medical-plans",
      "destination": "/businesses-and-organizations",
      "permanent": true
    },
    {
      "source": "/the-importance-and-benefits-of-group-health-medical-plans/",
      "destination": "/businesses-and-organizations",
      "permanent": true
    },
    { "source": "/why-choose-telehealth", "destination": "/features/primary-care", "permanent": true },
    { "source": "/why-choose-telehealth/", "destination": "/features/primary-care", "permanent": true },
    { "source": "/case/direct-member-handbook", "destination": "/3d-flip-book/direct-handbook", "permanent": true },
    { "source": "/case/guideline-changes-effective-01-01-25", "destination": "/resources", "permanent": true },
    { "source": "/case/how-to-go-shopping", "destination": "/resources", "permanent": true },
    { "source": "/concierge-playbook", "destination": "/features/membership-concierge", "permanent": true },
    { "source": "/member-guidelines", "destination": "/3d-flip-book/zion-guidelines", "permanent": true },
    { "source": "/phones", "destination": "/contact", "permanent": true },
    { "source": "/support-ticket", "destination": "/support", "permanent": true },
    { "source": "/support-ticket/", "destination": "/support", "permanent": true },
    { "source": "/account", "destination": "https://app.mpb.health/login", "permanent": true },
    { "source": "/account/", "destination": "https://app.mpb.health/login", "permanent": true },
    { "source": "/product/essentials", "destination": "/plans", "permanent": true },
    {
      "source": "/events/women-s-networking-event-with-sa-de-max",
      "destination": "/events",
      "permanent": true
    },
    {
      "source": "/blog/Earth-Day-From-Environmental-Awareness-to-Personal-Wellbeing",
      "destination": "/blog/Earth-Day",
      "permanent": true
    },
    {
      "source": "/blog/medical-cost-sharing-an-affordable-and-transparent-alternative-to-health-insurance",
      "destination": "/blog/what-is-health-sharing",
      "permanent": true
    },
    { "source": "/blog/ribbon-cutting", "destination": "/blog", "permanent": true },
    {
      "source": "/blog/functional-integrative-medicine-in-2025-redefining-how-americans-approach-health",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/the-silent-storm-why-older-men-struggle-with-mental-health-and-how-to-help",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/:year(20\\d{2})/:month(\\d{2})/:day(\\d{2})/:slug*",
      "destination": "/blog/:slug*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api|assets|favicon|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://vercel.live https://*.vercel.live https://www.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net https://snap.licdn.com https://static.ads-twitter.com https://s.pinimg.com https://ct.pinterest.com https://analytics.tiktok.com https://www.redditstatic.com https://sc-static.net https://*.clarity.ms https://c.bing.com https://static.hotjar.com https://salesiq.zohopublic.com https://salesiq.zoho.com https://salesiq.zohopublic.eu https://js.zohocdn.com https://static.zohocdn.com https://chimpstatic.com https://*.mailchimp.com https://assets.calendly.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://css.zohocdn.com https://static.zohocdn.com https://assets.calendly.com https://vercel.live; font-src 'self' data: https://fonts.gstatic.com https://css.zohocdn.com https://static.zohocdn.com https://assets.calendly.com; img-src 'self' data: https: blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://www.google-analytics.com https://analytics.google.com https://www.facebook.com https://px.ads.linkedin.com https://analytics.twitter.com https://ct.pinterest.com https://pixel-config.reddit.com https://analytics.tiktok.com https://www.reddit.com https://tr.snapchat.com https://*.clarity.ms https://c.bing.com https://*.hotjar.com https://*.hotjar.io wss://*.hotjar.com https://salesiq.zohopublic.com https://salesiq.zoho.com https://salesiq.zohopublic.eu wss://salesiq.zohopublic.com wss://salesiq.zoho.com wss://vts.zohopublic.com https://ipapi.co https://ipwho.is https://ip-api.com https://api.bigdatacloud.net https://api.zippopotam.us https://*.list-manage.com https://*.mailchimp.com https://calendly.com https://vercel.live https://*.vercel.live wss://vercel.live wss://*.vercel.live; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://www.cognitoforms.com https://*.enrollmpb.com https://salesiq.zohopublic.com https://salesiq.zoho.com https://salesiq.zohopublic.eu https://vars.hotjar.com https://www.google.com https://calendly.com https://drive.google.com https://docs.google.com https://vercel.live https://ct.pinterest.com; child-src 'self' https://www.cognitoforms.com https://*.enrollmpb.com https://salesiq.zohopublic.com https://salesiq.zoho.com https://salesiq.zohopublic.eu https://calendly.com; media-src 'self' https: data:; frame-ancestors 'self'; form-action 'self'; base-uri 'self'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "0"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self)"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/docs/:path*.pdf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
